# --- Data (see scripts/download_data.sh to reproduce) ---
data/raw/*
!data/raw/.gitkeep
!data/raw/*-metadata.json
data/interim/*
data/processed/*
data/external/*
!data/*/.gitkeep
# Blanket safety net: per committare una piccola tabella di lookup usa `git add -f`
*.csv
*.parquet
*.xlsx
*.db
*.duckdb
*.sqlite3

# --- Stato effimero della toolchain ---
# Scritto dall'estensione SpecKit Companion a ogni selezione di feature: contiene
# un timestamp, quindi versionarlo produrrebbe rumore in ogni diff.
specs/*/.spec-context.json

# --- Locali ---
# Output della regia e input di una sessione esecutiva: non sono artefatti del
# progetto. 
*.local.md
# Il piano di lavoro della regia: stime, scostamento, debito e rischi. Strumento
# di lavoro, non artefatto pubblicato. Uscito dal versionamento il 2026-08-29;
# ciò che vi era citato da fuori è stato migrato nei documenti che lo citavano.
docs/roadmap.md

# --- Credentials ---
.env
.env.*
!.env.example
kaggle.json
*.pem
*.key
secrets/

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.python-version
.ipynb_checkpoints/
.pytest_cache/
.ruff_cache/
.mypy_cache/
dist/
build/
*.egg-info/

# --- Node ---
node_modules/

# --- OS / editor ---
.DS_Store
Thumbs.db
*.swp
.idea/

# --- Outputs ---
reports/figures/*.png
!reports/figures/.gitkeep
